generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
  schemas  = ["hunt"]
}

model Company {
  id           String        @id @default(cuid())
  name         String        @unique
  normalized   String        @unique
  domain       String?
  country      String        @default("NG")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  generalSummary String?
  summaryUpdatedAt DateTime?
  summaryEvidenceAt DateTime?
  summaryVersion Int @default(0)
  watches      Watch[]
  observations Observation[]
  runs         MonitoringRun[]
  signals      Signal[]
  userWatches UserWatch[]
  clusters    SignalCluster[]
  opportunities OpportunityCandidate[]
  notifications Notification[]
  adminReviewTasks AdminReviewTask[]
  contacts     CompanyContact[]
  financialRecords FinancialRecord[]
  @@schema("hunt")
}

model Watch {
  id        String   @id @default(cuid())
  companyId String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@unique([companyId])
  @@schema("hunt")
}

model MonitoringRun {
  id               String         @id @default(cuid())
  companyId        String
  startedAt        DateTime       @default(now())
  finishedAt       DateTime?
  status           String         @default("running")
  observationCount Int            @default(0)
  errorCount       Int            @default(0)
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  observations     Observation[]
  signals          Signal[]
  clusters         SignalCluster[]
  @@schema("hunt")
}

model Observation {
  id          String         @id @default(cuid())
  companyId   String
  runId       String?
  source      String
  type        String
  category    String
  title       String
  url         String?
  fingerprint String
  observedAt  DateTime
  firstSeenAt DateTime       @default(now())
  lastSeenAt  DateTime       @default(now())
  metadata           Json?
  status             String   @default("active")
  missCount          Int      @default(0)
  lastProbeAt        DateTime?
  missingSince       DateTime?
  confirmedRemovedAt DateTime?
  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  run         MonitoringRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  @@unique([companyId, fingerprint])
  @@index([companyId, observedAt])
  @@schema("hunt")
}

model Signal {
  id                       String         @id @default(cuid())
  companyId                String
  runId                   String?
  score                    Int
  headline                 String
  detail                   String
  commercialInterpretation String
  createdAt                DateTime       @default(now())
  company                  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  run                      MonitoringRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  @@index([companyId, createdAt])
  @@schema("hunt")
}


model User {
  id               String        @id @default(cuid())
  email            String        @unique
  passwordHash     String
  plan             String        @default("free")
  pilotExpiresAt   DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  profile          UserProfile?
  sessions         Session[]
  userWatches       UserWatch[]
  opportunities     OpportunityCandidate[]
  notifications     Notification[]
  auditEvents       AuditEvent[]
  pilotCodes        PilotCode[]
  accessTokens      AccessToken[]
  @@schema("hunt")
}

model UserProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  profession            String?
  services              Json?
  industries            Json?
  geography             String?
  idealCustomer         String?
  targetCompanies       Json?
  desiredSignals        Json?
  exclusions            Json?
  commercialObjectives  Json?
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@schema("hunt")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@schema("hunt")
}


model UserWatch {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@unique([userId, companyId])
  @@index([userId, createdAt])
  @@schema("hunt")
}


model PilotCode {
  id               String   @id @default(cuid())
  codeHash         String   @unique
  createdAt        DateTime @default(now())
  expiresAt        DateTime?
  durationDays     Int      @default(14)
  redeemedAt       DateTime?
  redeemedByUserId String?
  redeemedBy       User?    @relation(fields: [redeemedByUserId], references: [id], onDelete: SetNull)
  @@index([expiresAt])
  @@schema("hunt")
}


model AccessToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  label      String   @default("MCP")
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt])
  @@schema("hunt")
}

model AdminAccessToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  label      String   @default("Admin AI")
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  @@index([revokedAt])
  @@schema("hunt")
}


model SignalCluster {
  id           String   @id @default(cuid())
  companyId    String
  runId        String?
  fingerprint  String
  score        Int
  headline     String
  detail       String
  categories   Json
  evidenceIds  Json
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  run          MonitoringRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  opportunities OpportunityCandidate[]
  notifications Notification[]
  @@unique([companyId, fingerprint])
  @@index([companyId, lastSeenAt])
  @@schema("hunt")
}

model OpportunityCandidate {
  id          String   @id @default(cuid())
  userId      String
  companyId   String
  clusterId   String
  fingerprint String
  score       Int
  reason      String
  evidenceIds Json
  status      String   @default("new")
  investigationState String @default("not_investigated")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cluster     SignalCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  notifications Notification[]
  @@unique([userId, fingerprint])
  @@index([userId, status, updatedAt])
  @@index([companyId, createdAt])
  @@schema("hunt")
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  companyId     String
  clusterId     String?
  opportunityId String?
  type          String
  title         String
  body          String
  readAt        DateTime?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cluster       SignalCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  opportunity   OpportunityCandidate? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  @@index([userId, readAt, createdAt])
  @@schema("hunt")
}


model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String
  resourceId String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@schema("hunt")
}

model CompanyContact {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  role        String   @default("")
  email       String?
  phone       String?
  linkedinUrl String?
  source      String
  sourceUrl   String?
  evidenceId  String?
  confidence  Int      @default(50)
  verificationStatus String @default("verified")
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@index([companyId, lastSeenAt])
  @@index([companyId, role])
  @@unique([companyId, name, role])
  @@schema("hunt")
}

model FinancialRecord {
  id             String   @id @default(cuid())
  companyId      String
  period         String
  statementType  String
  currency       String?
  source         String
  sourceUrl      String?
  publishedAt    DateTime?
  observedAt     DateTime @default(now())
  summary        String?
  metrics        Json?
  evidenceId     String?
  confidence     Int      @default(50)
  verificationStatus String @default("verified")
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@unique([companyId, period, statementType, source])
  @@index([companyId, publishedAt])
  @@index([companyId, observedAt])
  @@schema("hunt")
}


model AdminReviewTask {
  id          String   @id @default(cuid())
  companyId   String?
  type        String
  severity    String   @default("high")
  title       String
  detail      String
  sourceUrl   String?
  fingerprint String   @unique
  metadata    Json?
  status      String   @default("open")
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  @@index([status, createdAt])
  @@index([companyId, status])
  @@schema("hunt")
}

model AdminPushSubscription {
  id         String   @id @default(cuid())
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
  @@index([lastUsedAt])
  @@schema("hunt")
}