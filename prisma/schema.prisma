generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id           String        @id @default(cuid())
  name         String        @unique
  normalized   String        @unique
  domain       String?
  country      String        @default("NG")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  watches      Watch[]
  observations Observation[]
  runs         MonitoringRun[]
  signals      Signal[]
}

model Watch {
  id        String   @id @default(cuid())
  companyId String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId])
}

model MonitoringRun {
  id          String    @id @default(cuid())
  companyId   String
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  status      String    @default("running")
  observationCount Int  @default(0)
  errorCount  Int       @default(0)
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  signals     Signal[]
}

model Observation {
  id          String   @id @default(cuid())
  companyId   String
  runId       String?
  source      String
  type        String
  category    String
  title       String
  url         String?
  fingerprint String
  observedAt  DateTime
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  metadata    Json?
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  run         MonitoringRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([companyId, fingerprint])
  @@index([companyId, observedAt])
}

model Signal {
  id                    String   @id @default(cuid())
  companyId             String
  runId                 String?
  score                 Int
  headline              String
  detail                String
  commercialInterpretation String
  createdAt              DateTime @default(now())
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  run                   MonitoringRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}
