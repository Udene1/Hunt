generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["hunt"]
}

model Company {
  id           String        @id @default(cuid())
  name         String        @unique
  normalized   String        @unique
  domain       String?
  country      String        @default("NG")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  watches      Watch[]
  observations Observation[]
  runs         MonitoringRun[]
  signals      Signal[]
  userWatches UserWatch[]
  @@schema("hunt")
}

model Watch {
  id        String   @id @default(cuid())
  companyId String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@unique([companyId])
  @@schema("hunt")
}

model MonitoringRun {
  id               String         @id @default(cuid())
  companyId        String
  startedAt        DateTime       @default(now())
  finishedAt       DateTime?
  status           String         @default("running")
  observationCount Int            @default(0)
  errorCount       Int            @default(0)
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  observations     Observation[]
  signals          Signal[]
  @@schema("hunt")
}

model Observation {
  id          String         @id @default(cuid())
  companyId   String
  runId       String?
  source      String
  type        String
  category    String
  title       String
  url         String?
  fingerprint String
  observedAt  DateTime
  firstSeenAt DateTime       @default(now())
  lastSeenAt  DateTime       @default(now())
  metadata           Json?
  status             String   @default("active")
  missCount          Int      @default(0)
  lastProbeAt        DateTime?
  missingSince       DateTime?
  confirmedRemovedAt DateTime?
  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  run         MonitoringRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  @@unique([companyId, fingerprint])
  @@index([companyId, observedAt])
  @@schema("hunt")
}

model Signal {
  id                       String         @id @default(cuid())
  companyId                String
  runId                   String?
  score                    Int
  headline                 String
  detail                   String
  commercialInterpretation String
  createdAt                DateTime       @default(now())
  company                  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  run                      MonitoringRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  @@index([companyId, createdAt])
  @@schema("hunt")
}


model User {
  id               String        @id @default(cuid())
  email            String        @unique
  passwordHash     String
  plan             String        @default("free")
  pilotExpiresAt   DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  profile          UserProfile?
  sessions         Session[]
  userWatches       UserWatch[]
  @@schema("hunt")
}

model UserProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  profession            String?
  services              Json?
  industries            Json?
  geography             String?
  idealCustomer         String?
  targetCompanies       Json?
  desiredSignals        Json?
  exclusions            Json?
  commercialObjectives  Json?
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@schema("hunt")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@schema("hunt")
}
